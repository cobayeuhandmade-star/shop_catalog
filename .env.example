# ==============================================
# SHOP CATALOGUE — Environment Variables Template
# ==============================================
# Lưu ý: Khi lấy code về chạy, copy file này thành file .env.local và điền các thông tin thực tế.

# Database
# Điền chuỗi kết nối Database thực tế của server (PostgreSQL, MySQL, v.v.)
DATABASE_URL="postgresql://user:password@host:5432/shop_catalog"

# NextAuth
# Sinh một chuỗi ngẫu nhiên bảo mật để mã hóa phiên đăng nhập (Ví dụ: dùng lệnh `openssl rand -base64 32`)
NEXTAUTH_SECRET=""

# Điền tên miền thực tế của website khi đưa lên mạng (Ví dụ: https://www.tenmiencuaban.com)
NEXTAUTH_URL="http://localhost:3000"

# Upload
# Thư mục lưu trữ ảnh tải lên (nếu dùng local)
UPLOAD_DIR="./public/uploads"

# Cloudinary
# Lấy URL này ở mục Dashboard của tài khoản Cloudinary
CLOUDINARY_URL="cloudinary://my_key:my_secret@my_cloud_name"
